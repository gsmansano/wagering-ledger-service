{
  "info": {
    "name": "Wagering Ledger Service",
    "description": "Every endpoint, one request per status class (decision #43). Run the folders in order with the collection runner, or one request at a time. Each run uses a fresh player and fresh external ids. The status table is in README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) {",
          "  const run = Date.now().toString(36);",
          "  pm.collectionVariables.set('run', run);",
          "  pm.collectionVariables.set('playerId', 'postman-' + run);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "providerId",
      "value": "postman"
    },
    {
      "key": "run",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "walletId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "pendingTransactionId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "cursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Wallets",
      "item": [
        {
          "name": "Create wallet (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh run id per collection run: new player, new external ids.",
                  "const run = Date.now().toString(36);",
                  "pm.collectionVariables.set('run', run);",
                  "pm.collectionVariables.set('playerId', 'postman-' + run);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('walletId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\n    \"currency\": \"BRL\",\n    \"amount\": \"100.00\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create the same wallet again (409 WALLET_ALREADY_EXISTS)",
          "event": [
            {
              "listen": "test",
