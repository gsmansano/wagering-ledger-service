{
  "name": "wagering-ledger-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "poc:domain": "bun scripts/poc-domain.ts",
    "poc:wagering": "bash scripts/poc-wagering.sh",
    "poc:reversals": "bash scripts/poc-reversals.sh",
    "poc:consumer": "bash scripts/poc-consumer.sh",
    "poc:outbox": "bash scripts/poc-outbox.sh",
    "poc:multi": "bash scripts/poc-multi.sh",
    "poc:schema": "docker compose exec -T postgres psql -U wagering -d wagering -f - < scripts/poc-schema.sql",
    "migration:up": "bun src/infrastructure/database/migrate.ts up",
    "migration:down": "bun src/infrastructure/database/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1152.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12",
    "@types/bun": "1.4.3",
    "typescript": "6.0.3"
  }
}
