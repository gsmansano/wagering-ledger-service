PORT=3000
# JSON log level: trace, debug, info, warn, error, fatal or silent. The fields a line may carry: src/infrastructure/logging/log-fields.ts
LOG_LEVEL=info
# Longest total wait for a wallet lock (queue included) before the request gets a retryable 503 (0 = no limit)
WALLET_LOCK_TIMEOUT_MS=5000
# How long /metrics reuses its outbox, DLQ and readiness gauges (0 = read on every scrape)
METRICS_CACHE_MS=5000
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_MAX_RECEIVE_COUNT=5
# Reversals waiting for their reference: worker on/off, poll interval, retry limit and backoff (decisions #39, #40)
PENDING_REFERENCE_WORKER=on
PENDING_REFERENCE_POLL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BACKOFF_BASE_MS=1000
PENDING_REFERENCE_BACKOFF_CAP_MS=300000
# Outbox publisher: on/off, poll interval, batch per poll, retry limit before parking, backoff, send timeout (decisions #56-#59)
OUTBOX_WORKER=on
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_CAP_MS=300000
OUTBOX_SEND_TIMEOUT_MS=10000
# Queue consumer: on/off, receive batch size (1-10; keep 1, decision #67), parallel receive loops, long-poll wait, retry backoff (decisions #52, #55)
SQS_CONSUMER=on
SQS_CONSUMER_BATCH_SIZE=1
SQS_CONSUMER_CONCURRENCY=10
SQS_WAIT_TIME_SECONDS=20
SQS_RETRY_BASE_MS=1000
SQS_RETRY_CAP_MS=300000
# How long a stopping instance waits for messages in flight before handing them back to the queue
SQS_SHUTDOWN_TIMEOUT_MS=20000
# Prepended to the three queue names; leave empty except to isolate a run (the multi-instance tests set it)
SQS_QUEUE_PREFIX=
# Connections per instance (default 10). Requests queued on one wallet each hold one while they wait for its lock
DATABASE_POOL_MAX=10
